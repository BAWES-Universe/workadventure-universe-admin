generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Users
model User {
  id           String   @id @default(uuid())
  uuid         String   @unique // WorkAdventure user identifier
  email        String?  @unique
  name         String?
  matrixChatId String?  @map("matrix_chat_id") // Matrix ID: "@user:matrix.org"
  // The companion they wear now, in every world (null = none). Changed only by their own pick.
  companionTextureId String? @map("companion_texture_id")
  lastIpAddress String? @map("last_ip_address") // Last known IP address
  isGuest      Boolean  @default(false) @map("is_guest") // True for unauthenticated guest users
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  ownedUniverses    Universe[]        @relation("UniverseOwner")
  passedUniverses   Universe[]        @relation("UniversePreviousOwner")
  worldMemberships  WorldMember[]
  bans              Ban[]             @relation("BannedUser")
  bannedBy          Ban[]             @relation("BannedBy")
  bansLifted        Ban[]             @relation("BanLiftedBy")
  banAppealsDecided Ban[]             @relation("BanAppealDecidedBy")
  reportsAbout      Report[]          @relation("ReportedUser")
  reportsMade       Report[]          @relation("Reporter")
  reportsHandled    Report[]          @relation("ReportHandledBy")
  avatars           UserAvatar[]
  aiKeys            BotsAiProvider[]  @relation("AiKeyOwner")
  voiceKeys         VoiceProvider[]   @relation("VoiceKeyOwner")
  outfits           UserOutfit[]
  favorites         Favorite[]
  followers         Follow[]          @relation("Follower")
  following         Follow[]          @relation("Following")
  friendships1      Friendship[]      @relation("User1")
  friendships2      Friendship[]      @relation("User2")
  requestedFriendships Friendship[]   @relation("RequestedBy")
  roomAccesses      RoomAccess[]
  visitCard         VisitCard?
  membershipInvitationsSent MembershipInvitation[] @relation("InvitedBy")
  membershipInvitationsReceived MembershipInvitation[] @relation("InvitedUser")
  ownershipOffersReceived OwnershipOffer[] @relation("OwnershipOfferTo")
  ownershipOffersMade     OwnershipOffer[] @relation("OwnershipOfferBy")
  bricks            Bot[] @relation("BotOwner")
  defaultBrick      DefaultBrick?
  brickVisit        BrickVisit?
  brickOffers       BrickOffer[]
  brickItems        BrickItem[] @relation("BrickItemOwner")
  guestBrickHandovers GuestBrickHandover[]
  botsCreated       Bot[] @relation("BotCreatedBy")
  botsUpdated       Bot[] @relation("BotUpdatedBy")
  botAccessRules    BotAccessRule[]
  botToolsConfirmed BotMcpTool[] @relation("BotToolConfirmedBy")
  botToolsMoved     BotMcpTool[] @relation("BotToolMovedBy")
  botServersConnected BotMcpServer[] @relation("BotMcpServerConnectedBy")
  appConnections    AppConnection[] @relation("AppConnectionOwner")
  appConnectionsMade AppConnection[] @relation("AppConnectionConnectedBy")
  botConversations BotsConversation[]
  botMemories      BotsMemory[]
  avatarGrants     UserAvatarGrant[]
  avatarSetAuditLogs AvatarSetAuditLog[]
  preferences      UserPreference[]
  universeMemberships UniverseMember[]
  notices          UserNotice[]
  pushDevices      PushDevice[]
  pushActivity     PushActivity?
  artifacts        Artifact[]        @relation("ArtifactOwner")
  artifactAsks     ArtifactVersion[] @relation("ArtifactAsker")
  artifactPasses   ArtifactPass[]    @relation("ArtifactPassHolder")
  nearbySharedItems NearbySharedItem[]
  botUsageTalked   BotsAiUsage[]     @relation("UsageTalkedPerson")
  botFiles         BotFile[]         @relation("BotFileOwner")

  @@map("users")
}

// Per-user Orbit preferences (intro seen, dismissed guidance, declined invitations).
// Keys are allowlisted in lib/user-preferences.ts.
model UserPreference {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

// An image, video, link or file shared in a nearby chat this person was in (game #1424). The nearby chat itself keeps
// nothing once the tab closes: this list is what the person finds in that chat's "Media, links and files" afterwards.
// `itemKey` is the game's own key for the item, so the same item seen twice is kept once. A file from the game's
// uploader is kept by its bucket and file id ("bucket/id", its link may expire); anything else by its link.
model NearbySharedItem {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  itemKey    String   @map("item_key") @db.VarChar(300)
  // "media" (an image or video), "link" or "file"
  kind       String   @db.VarChar(10)
  name       String   @db.VarChar(300)
  link       String?  @db.VarChar(2000)
  fileId     String?  @map("file_id") @db.VarChar(200)
  mimeType   String?  @map("mime_type") @db.VarChar(150)
  size       Int?
  isVideo    Boolean  @default(false) @map("is_video")
  senderName String   @map("sender_name") @db.VarChar(100)
  // The sender's chat account, so the item shows in their profile (game #1615); null for items kept before it was sent
  senderChatId String? @map("sender_chat_id") @db.VarChar(255)
  // Sent by this person
  mine       Boolean  @default(false)
  // The chat accounts of the others in the chat when it was shared, so what this person sent shows in their profiles
  withChatIds String[] @default([]) @map("with_chat_ids")
  sentAt     DateTime @map("sent_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId, sentAt])
  @@index([userId, senderChatId, sentAt])
  @@index([withChatIds], type: Gin)
  @@map("nearby_shared_items")
}

// Something Orbit tells one person once, on Orbit home and in the attention count, until they dismiss it (#374: a key
// is down, a bot moved to Universe AI). `dedupeKey` makes "once": the same thing for the same person is never added twice.
model UserNotice {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  kind        String    @db.VarChar(40)
  dedupeKey   String    @map("dedupe_key") @db.VarChar(200)
  title       String    @db.VarChar(200)
  body        String    @db.VarChar(1000)
  // A short state pill beside the title ("Down"); null for none
  badge       String?   @db.VarChar(20)
  // An Orbit page the notice leads to
  href        String?   @db.VarChar(300)
  // What a notice with buttons needs to draw them and tell the time in the viewer's clock (a tool's lost sign-in, #1819)
  data        Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  dismissedAt DateTime? @map("dismissed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, dismissedAt])
  @@map("user_notices")
}

// A browser or installed app where this person turned on notifications (game #863): its Web Push subscription, which Orbit
// sends to while Universe is closed. One row per subscription; signing in elsewhere on the same browser moves it.
model PushDevice {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  // The push service address the browser gave; Orbit only keeps the push services of the main browsers
  endpoint       String    @unique @db.VarChar(1000)
  p256dh         String    @db.VarChar(200)
  auth           String    @db.VarChar(100)
  // What the person sees in Your devices ("Chrome on Android", "Universe app on iPhone")
  label          String    @db.VarChar(60)
  // The device's own on/off switch in Settings > Notifications
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  // Last time this device registered again (every start of Universe on it)
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")
  lastNotifiedAt DateTime? @map("last_notified_at")
  // Proves a direct message notification comes from this person's own Matrix pusher (the game registers it with
  // this secret, and Synapse sends it back). Cleared when the browser moves to someone else.
  gatewaySecret  String?   @map("gateway_secret") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

// Where someone is in Universe right now, from the game (game #863), so a direct message they are looking at or
// will see in Universe sends no notification. One row per person, across their devices.
model PushActivity {
  userId         String    @id @map("user_id")
  // The tabs where Universe is in front now, by tab id: when each last said so, and the chat open there
  fronts         Json      @default("{}")
  // The chat they just left
  leftChatRoomId String?   @map("left_chat_room_id") @db.VarChar(255)
  leftChatAt     DateTime? @map("left_chat_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_activity")
}

// A live artifact a bot made for a person (game #1422, Orbit #622): a mini app, a page, a Markdown document or an SVG
// drawing. The person who asked owns it and the bot is its maker. A guest owns nothing: what a guest asks for is kept
// for a day (expiresAt) and is gone after that. Who may open it and who may ask for changes are the two scopes below.
// Each change is one ArtifactVersion; the file of each version sits in the artifacts bucket under its fileKey.
model Artifact {
  id            String    @id @default(uuid())
  // The person who asked for it; null for a guest
  ownerId       String?   @map("owner_id")
  // The bot that made it, by id (kept when the bot is deleted) and the name it had
  makerBotId    String    @map("maker_bot_id") @db.VarChar(255)
  makerName     String    @map("maker_name") @db.VarChar(100)
  title         String    @db.VarChar(120)
  // app | page | markdown | svg
  kind          String    @db.VarChar(20)
  // The chat it was made in: nearby | dm, and the id the bot server and the game both use for that chat. A copy has none.
  chatKind      String?   @map("chat_kind") @db.VarChar(20)
  chatRef       String?   @map("chat_ref") @db.VarChar(255)
  // Who can open it: me (just its owner, game #1994) | chat (people in that chat) | link (anyone with the link)
  openScope     String    @default("chat") @map("open_scope") @db.VarChar(20)
  // Who can ask for changes: owner (only the owner) | openers (everyone who can open it, in its chat)
  changeScope   String    @default("owner") @map("change_scope") @db.VarChar(20)
  latestVersion Int       @default(1) @map("latest_version")
  copiedFromId  String?   @map("copied_from_id")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner    User?             @relation("ArtifactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  versions ArtifactVersion[]
  passes   ArtifactPass[]

  @@index([ownerId, updatedAt])
  @@index([makerBotId])
  @@index([expiresAt])
  @@map("artifacts")
}

model ArtifactVersion {
  id           String   @id @default(uuid())
  artifactId   String   @map("artifact_id")
  number       Int
  // What changed, in a line
  summary      String?  @db.VarChar(300)
  // Who asked for this version: the person (null for a guest) and the name they had then
  askedById    String?  @map("asked_by_id")
  askedByName  String?  @map("asked_by_name") @db.VarChar(100)
  // The file of this version in the artifacts bucket. Unguessable: it carries a random part.
  fileKey      String   @map("file_key") @db.VarChar(255)
  sizeBytes    Int      @map("size_bytes")
  // The songs, images and videos this version carries (#1510), beside its file in the same folder:
  // [{ name, contentType, sizeBytes, key }]. Empty for most versions.
  media        Json     @default("[]")
  createdAt    DateTime @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  askedBy  User?    @relation("ArtifactAsker", fields: [askedById], references: [id], onDelete: SetNull)

  @@unique([artifactId, number])
  @@index([askedById])
  @@map("artifact_versions")
}

// One opening of a "Just you" artifact by its owner (game #1994): the address its files are served at, by Orbit itself, for
// that opening (lib/artifact-pass.ts). It goes with the artifact and with the account.
model ArtifactPass {
  id         String    @id @default(uuid())
  // SHA-256 of the random part of the address. The address itself is never stored, so this table opens nothing.
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  artifactId String    @map("artifact_id")
  // The owner it was made for. Checked against the artifact's owner again on every request.
  userId     String    @map("user_id")
  // Set by the first request for the page: SHA-256 of the cookie that browser was given. The page then needs it.
  cookieHash String?   @map("cookie_hash") @db.VarChar(64)
  redeemedAt DateTime? @map("redeemed_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  artifact Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user     User     @relation("ArtifactPassHolder", fields: [userId], references: [id], onDelete: Cascade)

  @@index([artifactId])
  @@index([userId])
  @@index([expiresAt])
  @@map("artifact_passes")
}

// A file in the artifacts bucket whose address was handed out before its artifact became "Just you" (game #1994). It is
// removed from the bucket at once; it stays listed here until the bucket has confirmed, so a restart never forgets one.
model ArtifactRetiredFile {
  key       String   @id @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("artifact_retired_files")
}

// Universes
model Universe {
  id          String   @id @default(uuid())
  slug        String   @unique // URL identifier: "my-universe"
  name        String
  description String?
  ownerId     String   @map("owner_id")
  isPublic    Boolean  @default(true) @map("is_public")
  featured    Boolean  @default(false) // For discovery
  thumbnailUrl String? @map("thumbnail_url")
  // Hide bot conversations (#435): Orbit shows no transcript or bot memory text for any bot here, and the bot server
  // sends none to PostHog or Sentry. Bots still remember people either way. Off by default.
  hideBotConversations Boolean @default(false) @map("hide_bot_conversations")
  // Allow voice bots here (#740): a bot can only speak and listen in this universe while it is on.
  allowVoiceBots Boolean @default(true) @map("allow_voice_bots")
  // Visiting Bricks (game #2005): whether people may bring their own Brick along here. Off for every universe that
  // existed before it shipped, on for a universe made after.
  allowVisitingBricks Boolean @default(true) @map("allow_visiting_bricks")
  // Set when the universe was passed to this owner (#820): when, and from whom. Null for the person who created it.
  ownerSince      DateTime? @map("owner_since")
  previousOwnerId String?   @map("previous_owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  owner      User      @relation("UniverseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  previousOwner User?  @relation("UniversePreviousOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull)
  worlds     World[]
  bans       Ban[]
  favorites  Favorite[]
  roomAccesses RoomAccess[]
  roles      Role[]
  members    UniverseMember[]
  membershipInvitations MembershipInvitation[]
  aiKeyLends AiKeyLend[]
  voiceKeyLends VoiceKeyLend[]
  ownershipOffer OwnershipOffer?

  @@map("universes")
}

// Worlds
model World {
  id          String   @id @default(uuid())
  universeId  String   @map("universe_id")
  slug        String   // URL identifier: "office-world"
  name        String
  description String?
  isPublic    Boolean  @default(true) @map("is_public")
  featured    Boolean  @default(false) // For discovery
  thumbnailUrl String? @map("thumbnail_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  universe   Universe     @relation(fields: [universeId], references: [id], onDelete: Cascade)
  rooms      Room[]
  members    WorldMember[]
  bans       Ban[]
  reports    Report[]
  avatars    UserAvatar[]
  favorites  Favorite[]
  roomAccesses RoomAccess[]
  membershipInvitations MembershipInvitation[]
  avatarScopes AvatarSetScope[]

  @@unique([universeId, slug]) // Slug unique within universe
  @@map("worlds")
}

// Rooms
model Room {
  id          String   @id @default(uuid())
  worldId     String   @map("world_id")
  slug        String   // URL identifier: "lobby"
  name        String
  description String?
  mapUrl      String?  @map("map_url") // External TMJ URL (e.g., GitHub Pages)
  wamUrl      String?  @map("wam_url") // WAM file URL in map-storage (created via PUT)
  templateMapId String? @map("template_map_id") // Reference to template map if created from template
  authenticationMandatory Boolean @default(false) @map("authentication_mandatory")
  isPublic    Boolean  @default(true) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  world      World      @relation(fields: [worldId], references: [id], onDelete: Cascade)
  templateMap RoomTemplateMap? @relation(fields: [templateMapId], references: [id], onDelete: SetNull)
  favorites  Favorite[]
  roomAccesses RoomAccess[]
  bots       Bot[]
  reports    Report[]
  brickVisits BrickVisit[]

  @@unique([worldId, slug]) // Slug unique within world
  @@map("rooms")
}

// Room Access Analytics
model RoomAccess {
  id              String   @id @default(uuid())
  userUuid        String?  @map("user_uuid") // UUID from WorkAdventure (ephemeral for guests)
  userId          String?  @map("user_id") // Only set if authenticated user exists
  ipAddress       String   @map("ip_address") // IP address for tracking
  userName        String?  @map("user_name") // Name from request or user record
  userEmail       String?  @map("user_email") // Email from request or user record
  isGuest         Boolean  @default(true) @map("is_guest") // true if unauthenticated
  isAuthenticated Boolean  @default(false) @map("is_authenticated") // true if has OIDC token
  hasMembership   Boolean  @default(false) @map("has_membership") // true if has WorldMember record
  membershipTags  String[] @map("membership_tags") // Tags from membership if exists

  universeId      String   @map("universe_id")
  worldId         String   @map("world_id")
  roomId          String   @map("room_id")

  universeSlug    String   @map("universe_slug")
  worldSlug       String   @map("world_slug")
  roomSlug        String   @map("room_slug")

  playUri         String   @map("play_uri") // Full play URI

  textureIds      String[] @default([]) @map("texture_ids") // The Woka a guest picked (their account has its own saved outfit)

  accessedAt      DateTime @default(now()) @map("accessed_at")

  // Relations
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  universe        Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  world           World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  relinks         RoomAccessRelink[]

  @@index([universeId, accessedAt])
  @@index([worldId, accessedAt])
  @@index([roomId, accessedAt])
  @@index([userId, accessedAt])
  @@index([userUuid, accessedAt])
  @@index([ipAddress, accessedAt])
  @@index([accessedAt])
  @@map("room_accesses")
}

// Visitors (#531): each visit scripts/unverified-visits-relink.sql moved back onto an account, with what it held before,
// so scripts/unverified-visits-undo.sql can put it back. Nothing in the app reads it.
model RoomAccessRelink {
  id           String    @id @default(uuid())
  roomAccessId String    @map("room_access_id")
  userId       String    @map("user_id") // the account the visit was moved onto
  oldUserUuid  String?   @map("old_user_uuid")
  oldUserId    String?   @map("old_user_id")
  oldUserName  String?   @map("old_user_name")
  oldUserEmail String?   @map("old_user_email")
  oldIsGuest   Boolean   @map("old_is_guest")
  relinkedAt   DateTime  @default(now()) @map("relinked_at")
  undoneAt     DateTime? @map("undone_at")

  roomAccess RoomAccess @relation(fields: [roomAccessId], references: [id], onDelete: Cascade)

  @@index([roomAccessId])
  @@map("room_access_relinks")
}

// World Memberships
model WorldMember {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  worldId   String   @map("world_id")
  tags      String[] // Array of tags: ["admin", "editor", "member"]
  joinedAt  DateTime @default(now()) @map("joined_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@index([worldId])
  @@index([userId])
  @@map("world_members")
}

// Roles (#314). One list per universe, Discord style. Each role's permissions are one number, its bits fixed in
// lib/permissions.ts. The built-in roles (everyone, member, editor, admin) use the keys the game and saved maps already
// know as tags; a custom role's key is fixed when it is created, so renaming it never breaks a map.
model Role {
  id          String   @id @default(uuid())
  universeId  String   @map("universe_id")
  key         String   // Sent to the game as a tag
  name        String
  color       String   @default("#99AAB5")
  showBadge   Boolean  @default(true) @map("show_badge") // Off: only people who manage roles see it on others
  permissions BigInt   @default(0)
  position    Int      @default(0) // Higher ranks above; lib/roles.ts says where the built-ins sit
  builtIn     Boolean  @default(false) @map("built_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  universe    Universe             @relation(fields: [universeId], references: [id], onDelete: Cascade)
  assignments UniverseMemberRole[]
  botRules    BotAccessRule[]

  @@unique([universeId, key])
  @@map("roles")
}

// Joining a universe, once. Everyone who joined is a Member in the worlds below (all of them, or some), and in every
// world one of their roles works in. lib/roles.ts keeps world_members (and its tags) filled from these rows.
model UniverseMember {
  id         String   @id @default(uuid())
  universeId String   @map("universe_id")
  userId     String   @map("user_id")
  allWorlds  Boolean  @default(false) @map("all_worlds")
  worldIds   String[] @default([]) @map("world_ids")
  joinedAt   DateTime @default(now()) @map("joined_at")

  universe Universe             @relation(fields: [universeId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles    UniverseMemberRole[]

  @@unique([universeId, userId])
  @@index([userId])
  @@map("universe_members")
}

// One role given to one member, working in every world or only the ones listed.
model UniverseMemberRole {
  id        String   @id @default(uuid())
  memberId  String   @map("member_id")
  roleId    String   @map("role_id")
  allWorlds Boolean  @default(false) @map("all_worlds")
  worldIds  String[] @default([]) @map("world_ids")
  createdAt DateTime @default(now()) @map("created_at")

  member UniverseMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([roleId])
  @@map("universe_member_roles")
}

// Bans
model Ban {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  universeId String?  @map("universe_id")
  worldId   String?   @map("world_id")
  ipAddress String?   @map("ip_address") // IPv4 or IPv6
  reason    String?
  bannedById String?  @map("banned_by")
  bannedAt  DateTime  @default(now()) @map("banned_at")
  expiresAt DateTime? @map("expires_at") // NULL = permanent
  isActive  Boolean   @default(true) @map("is_active")
  liftedAt  DateTime? @map("lifted_at")
  liftedById String?  @map("lifted_by")
  // One appeal per ban: the banned player's message, and the admins' answer
  appealText       String?   @map("appeal_text")
  appealedAt       DateTime? @map("appealed_at")
  appealDecision   String?   @map("appeal_decision") // "kept" | "lifted"; NULL while waiting
  appealDecidedAt  DateTime? @map("appeal_decided_at")
  appealDecidedById String?  @map("appeal_decided_by")

  // Relations
  user      User?     @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  universe  Universe? @relation(fields: [universeId], references: [id], onDelete: SetNull)
  world     World?    @relation(fields: [worldId], references: [id], onDelete: Cascade) // a ban is about its world
  bannedBy  User?     @relation("BannedBy", fields: [bannedById], references: [id])
  liftedBy  User?     @relation("BanLiftedBy", fields: [liftedById], references: [id], onDelete: SetNull)
  appealDecidedBy User? @relation("BanAppealDecidedBy", fields: [appealDecidedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([ipAddress])
  @@index([worldId])
  @@map("bans")
}

// A player's report about another player, seen by the world's admins and the universe owner
model Report {
  id             String    @id @default(uuid())
  worldId        String    @map("world_id")
  roomId         String?   @map("room_id")
  reportedUserId String?   @map("reported_user_id")
  reportedUuid   String    @map("reported_uuid") // As the game sent it, kept when no Orbit user matches
  reporterUserId String?   @map("reporter_user_id")
  reporterUuid   String    @map("reporter_uuid")
  comment        String
  status         String    @default("open") // "open" | "dismissed" | "banned"
  handledById    String?   @map("handled_by")
  handledAt      DateTime? @map("handled_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  world        World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  room         Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reporterUser User? @relation("Reporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  handledBy    User? @relation("ReportHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([worldId, status])
  @@index([reportedUserId])
  @@map("reports")
}

// User Avatars & Companions
model UserAvatar {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  worldId         String   @map("world_id")
  textureIds      String[] @map("texture_ids") // Array of texture IDs: ["male1", "hat1"]
  companionTextureId String? @map("companion_texture_id")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")
  // When the outfit itself was last picked (a companion change leaves it alone)
  outfitUpdatedAt DateTime? @map("outfit_updated_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  world World @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([userId, worldId])
  @@map("user_avatars")
}

// The Wokas a person has worn, newest first. The newest (lastWornAt) is the one they wear now, in every world; the rest
// are their Recent list (lib/user-outfits.ts keeps it short: 30 days, 10 rows, try-ons dropped).
model UserOutfit {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  textureIds  String[] @map("texture_ids")
  outfitKey   String   @map("outfit_key") // textureIds joined with "|", in order
  firstWornAt DateTime @default(now()) @map("first_worn_at")
  lastWornAt  DateTime @default(now()) @map("last_worn_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, outfitKey])
  @@index([userId, lastWornAt])
  @@map("user_outfits")
}

// Favorites (for future social features)
model Favorite {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  universeId String?   @map("universe_id")
  worldId    String?   @map("world_id")
  roomId     String?   @map("room_id")
  favoritedAt DateTime @default(now()) @map("favorited_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universe Universe? @relation(fields: [universeId], references: [id], onDelete: Cascade)
  world    World?   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomId])
  @@index([worldId])
  @@index([universeId])
  @@map("favorites")
}

// Follows (for future social features)
model Follow {
  id         String   @id @default(uuid())
  followerId String   @map("follower_id")
  followingId String @map("following_id")
  followedAt DateTime @default(now()) @map("followed_at")

  // Relations
  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// Friendships (for future social features)
model Friendship {
  id         String    @id @default(uuid())
  user1Id    String    @map("user1_id")
  user2Id    String    @map("user2_id")
  status     String    @default("pending") // pending, ignored, accepted, blocked (see lib/friends.ts)
  requestedById String? @map("requested_by")
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  // Relations
  user1       User   @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2       User   @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)
  requestedBy User?  @relation("RequestedBy", fields: [requestedById], references: [id])

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@map("friendships")
}

// Visit Cards
model VisitCard {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  bio       String?  // Optional bio/description
  links     Json     // Array of { label: string, url: string } objects
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("visit_cards")
}

// Membership Invitations
model MembershipInvitation {
  id            String   @id @default(uuid())
  worldId       String   @map("world_id")
  invitedUserId String   @map("invited_user_id")
  invitedByUserId String  @map("invited_by_user_id")
  status        String   @default("pending") // pending, accepted, rejected, cancelled
  tags          String[] // Tags that will be assigned when accepted (invitations sent before roles)
  // Roles (#314): the universe they join, the roles they get and the worlds they work in. world_id stays the world it
  // was sent from (or the first world picked), for the screens that show one.
  universeId    String?  @map("universe_id")
  roleIds       String[] @default([]) @map("role_ids")
  allWorlds     Boolean  @default(false) @map("all_worlds")
  worldIds      String[] @default([]) @map("world_ids")
  message       String?
  invitedAt     DateTime @default(now()) @map("invited_at")
  respondedAt   DateTime? @map("responded_at")

  // Relations
  world       World @relation(fields: [worldId], references: [id], onDelete: Cascade)
  universe    Universe? @relation(fields: [universeId], references: [id], onDelete: Cascade)
  invitedUser User  @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@unique([worldId, invitedUserId, status], name: "UniquePendingInvitation")
  @@index([worldId])
  @@index([invitedUserId])
  @@index([invitedByUserId])
  @@index([status])
  @@map("membership_invitations")
}

// Passing a universe to another account (#820). One waiting offer per universe (the unique universe_id), no time limit.
// It ends when the person accepts or declines, the owner takes it back, the person leaves or is removed, or the
// universe is deleted. The universe's owner changes only on accept, in one transaction (lib/ownership-offer.ts).
model OwnershipOffer {
  id            String   @id @default(uuid())
  universeId    String   @unique @map("universe_id")
  toUserId      String   @map("to_user_id")
  /** Who started it: the owner, or a super admin acting for them. */
  offeredById   String   @map("offered_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  universe  Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  toUser    User     @relation("OwnershipOfferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  offeredBy User     @relation("OwnershipOfferBy", fields: [offeredById], references: [id], onDelete: Cascade)

  @@index([toUserId])
  @@map("ownership_offers")
}

// Room Template Categories
model RoomTemplateCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?  // emoji
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  templates   RoomTemplate[]

  @@map("room_template_categories")
}

// Room Templates
model RoomTemplate {
  id               String   @id @default(uuid())
  categoryId       String   @map("category_id")
  slug             String   @unique
  name             String
  shortDescription String?  @map("short_description")
  philosophy       String?
  purpose          String?
  whoItsFor        String?  @map("who_its_for")
  typicalUseCases  String[] @map("typical_use_cases")
  visibility       String   @default("public")
  isFeatured       Boolean  @default(false) @map("is_featured")
  authorId         String?  @map("author_id")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  category         RoomTemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  maps             RoomTemplateMap[]

  @@map("room_templates")
}

// Room Template Maps (Actual Selectable Maps)
model RoomTemplateMap {
  id                  String   @id @default(uuid())
  templateId          String   @map("template_id")
  slug                String
  name                String
  description         String?
  mapUrl              String   @map("map_url")
  previewImageUrl     String?  @map("preview_image_url")
  sizeLabel           String?  @map("size_label")
  orientation         String   @default("orthogonal")
  tileSize            Int      @default(32) @map("tile_size")
  recommendedWorldTags String[] @map("recommended_world_tags")
  authorId            String?  @map("author_id")
  order               Int      @default(0)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  template            RoomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rooms               Room[]

  @@unique([templateId, slug])
  @@index([templateId])
  @@map("room_template_maps")
}

// Settings for the whole server that a super admin changes in Orbit (#666), one JSON value per key. "bot-limits": the
// reply limits on Universe AI, the artifact limits, the "Say when nothing was saved" switch and fair usage (lib/bot-limits.ts).
model AppSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("app_settings")
}

// Bots
model Bot {
  id                  String   @id @default(uuid())
  // Where the bot lives. A room bot has a room and no owner. A Brick (game #1992) has an owner and no room: it lives in
  // its owner's chats. The database holds a bot to exactly one of the two (bots_room_or_owner).
  roomId              String?  @map("room_id")
  // The person a Brick belongs to: whoever made it. Null for a room bot, which belongs to its room and is managed by
  // the room's people. "Created by" on a room bot only says who typed it in, and is never read as ownership.
  ownerId             String?  @map("owner_id")
  name                String   @db.VarChar(100)
  description         String?
  characterTextureId  String?  @map("character_texture_id") @db.VarChar(100)
  enabled             Boolean  @default(true)
  behaviorType        String   @default("idle") @map("behavior_type") @db.VarChar(20)
  behaviorConfig      Json     @default("{}") @map("behavior_config")
  chatInstructions    String?  @map("chat_instructions")
  movementInstructions String?  @map("movement_instructions")
  aiProviderRef       String?  @map("ai_provider_ref") @db.VarChar(100)
  // The model the bot replies with when it runs on a person's own key (#575): one of that key's models, and one its lend
  // allows. Null = the key's check model (BotsAiProvider.model). Not read for Universe AI or a server provider.
  aiModel             String?  @map("ai_model") @db.VarChar(255)
  // How long the bot waits for a tool to answer, in seconds. Null = the bot server's default (90 s).
  toolTimeoutSeconds  Int?     @map("tool_timeout_seconds")
  // The companion (pet) that walks with the bot: a companion texture id from the room's companion list, or none.
  companionTextureId  String?  @map("companion_texture_id") @db.VarChar(100)
  // Who may use the bot (#427). Private: only the roles and people with a Yes in accessRules (and its owner and Admin).
  privateBot          Boolean  @default(false) @map("private_bot")
  // What the bot says to people who may not chat with it; null = a plain default line. Never reaches the AI.
  refusalReply        String?  @map("refusal_reply") @db.VarChar(500)
  // Replies each person may get from this bot in a day; null = no limit. Stored here; nothing reads it yet (#1159).
  dailyReplyCap       Int?     @map("daily_reply_cap")
  // A bot's own reply limits (#666), never above its key's (or Universe AI's): the longest reply in tokens and the tool
  // steps in one reply. Null = follow the key.
  maxReplyTokens      Int?     @map("max_reply_tokens")
  maxSteps            Int?     @map("max_steps")
  // Hide bot conversations (#435) for this bot alone. null = follow the universe (default), true = Private, false = Normal.
  // A universe that hides them wins: a bot cannot be loosened below it.
  hideConversations   Boolean? @map("hide_conversations")
  // When a bot asks before a tool runs (#738): before making more than this many things in one request (null = no limit),
  // how often it asks which way to go (rarely | beforeBiggerJobs | never), and how long a card waits for an answer.
  askBeforeMaking     Int?     @default(5) @map("ask_before_making")
  askWhichWay         String   @default("rarely") @map("ask_which_way") @db.VarChar(20)
  cardWaitMinutes     Int      @default(10) @map("card_wait_minutes")
  // "Allow more of the same in this chat" (game #1659): a card's remembered approval ends after this many minutes without
  // the asker's messages (30 | 60 | 120) and after this many minutes at most (240 | 480 | 1440).
  allowMoreIdleMinutes Int     @default(60) @map("allow_more_idle_minutes")
  allowMoreMaxMinutes  Int     @default(480) @map("allow_more_max_minutes")
  // Voice (#740): off until a person with Manage bots turns it on. voiceRevision is the published voice profile the bot
  // speaks with (BotVoiceRevision.number); null until one is published.
  voiceEnabled        Boolean  @default(false) @map("voice_enabled")
  voiceRevision       Int?     @map("voice_revision")
  // A Brick its owner deleted (game #1996) waits until `goneAt`, and Undo gives it back before then. While it waits it
  // is off and nobody's to use (the database holds a deleted Brick to `enabled` false, bots_deleted_brick), and
  // `enabledBeforeDelete` is where Undo leaves its switch. All three are null for every other bot, a room bot always.
  deletedAt           DateTime? @map("deleted_at")
  goneAt              DateTime? @map("gone_at")
  enabledBeforeDelete Boolean?  @map("enabled_before_delete")
  // The first line of a Brick's chat, shown by the game while nothing has been written there (game #1996). Written once
  // when the Brick is made for a job ("Send me the first recipe"); null = the game's own fixed hello. Never sent as a
  // message and never read by the AI. Always null for a room bot.
  hello               String?   @db.VarChar(300)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdById         String?  @map("created_by_id")
  updatedById          String?  @map("updated_by_id")

  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner User? @relation("BotOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy User? @relation("BotCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("BotUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  mcpServers BotMcpServer[]
  accessRules BotAccessRule[]
  replyLimitHits BotReplyLimitHit[]
  files          BotFile[]
  fileCounter    BotFileCounter?
  actionRequests BotActionRequest[]
  actionGrants   BotActionGrant[]
  voiceDraft     BotVoiceDraft?
  voiceRevisions BotVoiceRevision[]
  voiceKeyUsage  VoiceKeyUsage[]
  voiceReplyUses VoiceReplyUse[]
  voiceListenUses VoiceListenUse[]
  defaultBrickOf  DefaultBrick?
  visit           BrickVisit?
  computer        BrickComputer?
  computerJobs    ComputerJob[]
  brickItems      BrickItem[]

  @@index([roomId])
  @@index([ownerId])
  @@index([goneAt])
  @@map("bots")
}

// The Brick every signed-in person gets (game #1995). One row per account, written the first time the Brick is made, so
// it is made once: two devices, a double tap or a later sign-in find the row and make nothing. The row stays when the
// Brick is deleted (botId goes back to null), which is how a Brick deleted on purpose is remembered and never made again.
model DefaultBrick {
  userId String   @id @map("user_id")
  botId  String?  @unique @map("bot_id")
  madeAt DateTime @default(now()) @map("made_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@map("default_bricks")
}

// A person's Brick walking beside them in another place (game #2005, "Bring along"). One row per person: one Brick walks
// with a person at a time, and bringing another swaps them. It is the same Brick, never a copy, and the row holds
// nothing of its owner's: only which Brick, whose, where it was last seen and when. `roomId` and `seenAt` come from the
// bot server each time it finds the person in a room, so Orbit knows where the visit is without being told where
// people are. A visit nobody has seen for a while ends by itself (Limits, "Bricks"); ending it deletes only this row.
model BrickVisit {
  userId    String   @id @map("user_id")
  botId     String   @unique @map("bot_id")
  roomId    String?  @map("room_id")
  // When the person's game saw them come into `roomId` (the game's own time, never later than the moment Orbit heard it). A
  // visit only moves to another room on a sighting newer than this, so a late sync from a room they left moves nothing
  roomSince DateTime? @map("room_since")
  // Which page load of the player's game said it. Times are only compared with each other when the same one said both: a
  // second device has its own clock, and its first sighting is a move
  roomClient String? @map("room_client") @db.VarChar(64)
  startedAt DateTime @default(now()) @map("started_at")
  seenAt    DateTime @default(now()) @map("seen_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  Bot   @relation(fields: [botId], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([roomId, seenAt])
  @@map("brick_visits")
}

// A reply the Brick for guests gave or was asked for (game #1997). The Brick for guests is Universe's own and has no bot
// row, so its allowance is counted here and nowhere else: not in a guest's Universe AI replies for a host's bots and not
// in a host bot's guest pool. Only totals are kept: who (the guest's id, never a name), where (the universe), when, and
// what it took. Never what was said.
model GuestBrickReply {
  id          String   @id @default(uuid())
  // Set by the bot server for the one turn; the same turn asked twice counts once
  turnId      String   @unique @map("turn_id") @db.VarChar(255)
  // The universe's id, or "outside" for a room that is in no universe
  universeKey String   @map("universe_key") @db.VarChar(64)
  // The guest's id as the bot server knows them (the uuid the game made at their first visit)
  guestKey    String   @map("guest_key") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  // A reply that failed is given back: it is not counted
  failed      Boolean  @default(false)
  tokensUsed  Int?     @map("tokens_used")
  // Millionths of a dollar, when the bot server knew it
  costMicros  Int?     @map("cost_micros")

  @@index([universeKey, createdAt])
  @@index([guestKey, createdAt])
  @@map("guest_brick_replies")
}

// A guest's chat with the Brick for guests, handed to the account they signed in with (game #1997). One row per guest id,
// so the chat goes to one account once: a second tab, a second sign-in and a different account find the row and take
// nothing. `carriedAt` is set once, by the first device that asks for it, so one device attaches the chat.
model GuestBrickHandover {
  guestKey  String    @id @map("guest_key") @db.VarChar(255)
  userId    String    @map("user_id")
  claimedAt DateTime  @default(now()) @map("claimed_at")
  carriedAt DateTime? @map("carried_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("guest_brick_handovers")
}

// A suggestion to make a Brick for a kind of job that keeps coming back (game #1996). One row per person and topic, and
// the row is the whole rule: a topic is suggested at most once to a person, in every chat and on every device, whatever
// they answered. `answer` is made | not_now once they tapped one; null while the card waits or was closed unanswered.
model BrickOffer {
  userId     String    @map("user_id")
  // The topic in a few plain words as the Brick named it, lower case ("recipes")
  topic      String    @db.VarChar(60)
  answer     String?   @db.VarChar(10)
  offeredAt  DateTime  @default(now()) @map("offered_at")
  answeredAt DateTime? @map("answered_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
  @@map("brick_offers")
}

// A reminder, a schedule, a watch or a goal a person gave their Brick (game #2002). Universe's own scheduler keeps them all
// here: no provider timer ever starts a run. `kind` is never asked of the person; the Brick works it out from their words.
// `cadence` is one of { type: once | daily | every | none } (lib/brick-item-time.ts) and is read on the clock of `timeZone`,
// the zone the item was set in, so travelling never moves it. `revision` goes up with every change that must stop work
// that already started (pause, done, delete, change, reopen): a run belongs to one revision and is dropped when it moves.
// `parentId` is the goal a check was set by; ending a goal ends only its own checks, never a reminder the person set.
model BrickItem {
  id            String    @id @default(uuid())
  ownerId       String    @map("owner_id")
  botId         String    @map("bot_id")
  // reminder, schedule, watch, goal
  kind          String    @db.VarChar(10)
  // What was asked, in the person's words, or the fixed text of a reminder
  words         String
  // A watch: when it should speak
  condition     String?
  // A goal: the outcome the person named
  outcome       String?
  cadence       Json
  timeZone      String    @map("time_zone") @db.VarChar(64)
  // When it is next due; empty when nothing is due (done, paused, or a goal that waits for something)
  nextDueAt     DateTime? @map("next_due_at")
  // What a goal with no timed check waits for, in a line
  waitingFor    String?   @map("waiting_for") @db.VarChar(300)
  // A goal's one status line and its steps ([{ text, state: todo | doing | done }])
  statusLine    String?   @map("status_line") @db.VarChar(300)
  steps         Json      @default("[]")
  // on, paused, done, deleted
  state         String    @default("on") @db.VarChar(10)
  // you (the person asked), brick (a check a goal set for itself)
  setBy         String    @default("you") @map("set_by") @db.VarChar(5)
  revision      Int       @default(1)
  parentId      String?   @map("parent_id")
  // Why it is paused: owner (they paused it) or brick_deleted (its Brick was deleted; Undo never switches it back on)
  pausedBy      String?   @map("paused_by") @db.VarChar(14)
  // The result a finished goal or watch ended with, in a line
  result        String?   @db.VarChar(1000)
  doneAt        DateTime? @map("done_at")
  lastRunAt     DateTime? @map("last_run_at")
  // Runs that failed one after another; a good run sets it back to 0
  failuresInRow Int       @default(0) @map("failures_in_row")
  // Whether the person was told about the failures in a row so far; cleared by the next run that works
  failureTold   Boolean   @default(false) @map("failure_told")
  // The run that was asked to tell the person about this row of failures, until it confirms (markTold) or the row starts over
  tellRunId     String?   @map("tell_run_id") @db.VarChar(36)
  // Set while a run waits because the person's Universe AI usage for goals and tasks is used up (it carries on when it is back), and
  // when Brick was last asked to say so (asked again after a while until it confirms) and when it confirmed: told once per wait
  heldSince   DateTime?   @map("held_since")
  heldToldAt  DateTime?   @map("held_told_at")
  heldNoticeAt  DateTime? @map("held_notice_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  owner  User           @relation("BrickItemOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  bot    Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  parent BrickItem?     @relation("BrickItemChecks", fields: [parentId], references: [id], onDelete: Cascade)
  checks BrickItem[]    @relation("BrickItemChecks")
  runs   BrickItemRun[]

  @@index([ownerId, state])
  @@index([botId])
  @@index([state, nextDueAt])
  @@index([parentId])
  @@map("brick_items")
}

// One run of an item at one due time. The unique pair (itemId, dueAt) is what makes a run happen once: whoever writes the row
// owns the run, and two servers or a retry find it and run nothing. A claimed run that never reports is given back after its
// lease (`attempts` counts the tries); the run's own id is what an outside effect is looked up by before it is written again.
model BrickItemRun {
  id         String    @id @default(uuid())
  itemId     String    @map("item_id")
  dueAt      DateTime  @map("due_at")
  // The item's revision when the run was claimed
  revision   Int
  claimedAt  DateTime  @default(now()) @map("claimed_at")
  leaseUntil DateTime  @map("lease_until")
  attempts   Int       @default(1)
  // A reminder or briefing run after an outage, marked "Late (due 8:00)"
  late       Boolean   @default(false)
  // A watch or goal check run after an outage: one fresh check, never the missed ones
  fresh      Boolean   @default(false)
  // claimed, done, failed, dropped (the item changed before it ran)
  state      String    @default("claimed") @db.VarChar(8)
  // What it came to: quiet, spoke, waiting, or empty while it runs
  outcome    String?   @db.VarChar(10)
  // The result in a line, for "Everything Brick did"
  result     String?   @db.VarChar(1000)
  error      String?   @db.VarChar(300)
  finishedAt DateTime? @map("finished_at")
  // The chat event of the message this run sent, once it is sent: a run handed out again looks here (and for its marker in the
  // chat) before it writes anything, so a message is never sent twice. Never claimed as exactly once outside Universe.
  deliveredEventId String? @map("delivered_event_id") @db.VarChar(255)
  deliveredAt      DateTime? @map("delivered_at")

  item BrickItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, dueAt])
  @@index([itemId, claimedAt])
  @@index([state, leaseUntil])
  @@map("brick_item_runs")
}

// One role's or one person's No / Default / Yes for a bot (#427), the same shape room overrides will reuse: two
// numbers over the permission bits in lib/permissions.ts. `allow` has a bit set where the answer is Yes, `deny` where
// it is No, and a bit in neither is Default (the roles decide). Only the four bot bits are ever set, never both.
// A row is for a role or for a person, never both (a check in the migration).
model BotAccessRule {
  id        String   @id @default(uuid())
  botId     String   @map("bot_id")
  roleId    String?  @map("role_id")
  userId    String?  @map("user_id")
  allow     BigInt   @default(0)
  deny      BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  bot  Bot   @relation(fields: [botId], references: [id], onDelete: Cascade)
  role Role? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([botId, roleId])
  @@unique([botId, userId])
  @@index([roleId])
  @@index([userId])
  @@map("bot_access_rules")
}

// Bot MCP Servers
model BotMcpServer {
  id          String   @id @default(uuid())
  botId       String   @map("bot_id")
  name        String   @db.VarChar(255)
  serverUrl   String   @map("server_url") @db.Text
  authType    String   @default("none") @map("auth_type") @db.VarChar(20)   // none | bearer | api-key
  authConfig  String?  @map("auth_config") @db.Text                          // encrypted JSON
  headers     Json?                                                          // extra headers key-value pairs
  enabled     Boolean  @default(true)
  lastTestedAt   DateTime?  @map("last_tested_at")
  lastTestResult Json?      @map("last_test_result")
  // Servers that existed before tools were checked (#738) keep working as they do in text, shown as "Not checked yet",
  // until their tools are confirmed.
  legacyText     Boolean    @default(false) @map("legacy_text")
  // What a bot does with a tool under each heading: rightAway | asksFirst | off.
  lookUpSetting      String @default("rightAway") @map("look_up_setting") @db.VarChar(20)
  makeSetting        String @default("rightAway") @map("make_setting") @db.VarChar(20)
  changeSetting      String @default("asksFirst") @map("change_setting") @db.VarChar(20)
  deleteSendSetting  String @default("asksFirst") @map("delete_send_setting") @db.VarChar(20)
  // Goes up whenever a heading setting, a tool's heading or a tool's confirmation changes, so a card or a remembered
  // approval made under an older policy can be told apart.
  policyRevision     Int    @default(1) @map("policy_revision")
  // The bot server shows at most 500 tools per server. When a server has more, it says so when it saves the list, and how
  // many it has when it knows (null when it did not read them all).
  toolsCut           Boolean @default(false) @map("tools_cut")
  toolsSeen          Int?    @map("tools_seen")
  // What the bot server last saw when it really used the server (game #1819), reported by it: a refused sign-in (401 or
  // 403) with when it first happened and the status, or a server that did not answer. Both clear when it works again, and
  // a reconnect or a saved new key or token clears them at once; `reconnectedAt` is when that last happened.
  signInLostAt       DateTime? @map("sign_in_lost_at")
  signInLostStatus   Int?      @map("sign_in_lost_status")
  noAnswerAt         DateTime? @map("no_answer_at")
  reconnectedAt      DateTime? @map("reconnected_at")
  // Who connected it last (a sign-in, a key or a token), the person told when its sign-in expires. Null for connections
  // made before this was kept: the bot's maker is told instead.
  connectedById      String?   @map("connected_by_id")
  // Set when this row is a Brick's grant on a person's connection (#2001): the link, sign-in, extra headers and the sign-in
  // lost fields above are then read from the connection and never copied, and what is kept here is the Brick's own: its
  // four headings, its tools and their confirmations, its switch. Null for every app set up on a bot as before.
  connectionId       String?   @map("connection_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bot         Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  connection  AppConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  connectedBy User?         @relation("BotMcpServerConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  tools       BotMcpTool[]

  @@unique([botId, connectionId])
  @@index([botId])
  @@index([connectionId])
  @@map("bot_mcp_servers")
}

// An app a person connected once (#2001, game "Apps"): the link, the sign-in, key or token (encrypted as a bot's server's is),
// the extra headers, who connected it and the sign-in lost fields. It belongs to ONE person and is used only for that person's
// own requests. A Brick of theirs uses it through a grant, which is a BotMcpServer row with this id; no bot has one by default.
// Removing the connection deletes every grant with it (onDelete cascade), so every Brick stops at once.
model AppConnection {
  id          String   @id @default(uuid())
  ownerId     String   @map("owner_id")
  name        String   @db.VarChar(255)
  serverUrl   String   @map("server_url") @db.Text
  authType    String   @default("none") @map("auth_type") @db.VarChar(20)   // none | bearer | api-key | oauth
  authConfig  String?  @map("auth_config") @db.Text                          // encrypted JSON
  headers     Json?
  // Where it came from: link = the person pasted its link ("Added by you"); listed = an entry of the super admin's list
  source      String   @default("link") @db.VarChar(20)
  // The one ticket a sign-in page may bring back: set when a sign-in starts, cleared when it is used, so a replayed return, or
  // one from a sign-in that a newer start replaced, is refused
  signInNonce        String?   @map("sign_in_nonce") @db.VarChar(64)
  // Held while one request renews the token, so two never spend the same refresh token (a rotating one would sign the person out)
  refreshLeaseUntil  DateTime? @map("refresh_lease_until")
  // What the bot server last saw (the same fields a bot's server has, game #1819); a reconnect clears them
  signInLostAt       DateTime? @map("sign_in_lost_at")
  signInLostStatus   Int?      @map("sign_in_lost_status")
  noAnswerAt         DateTime? @map("no_answer_at")
  reconnectedAt      DateTime? @map("reconnected_at")
  connectedById      String?   @map("connected_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner       User     @relation("AppConnectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  connectedBy User?    @relation("AppConnectionConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  grants      BotMcpServer[]

  @@index([ownerId])
  @@map("app_connections")
}

// One tool of a bot's MCP server (#738): what the server says it is, what we suggest it does, and what a person with
// Manage bots chose and confirmed. A suggestion never lets a tool run: only a confirmed heading does.
model BotMcpTool {
  id              String    @id @default(uuid())
  serverId        String    @map("server_id")
  name            String    @db.VarChar(255)
  title           String?   @db.VarChar(255)
  description     String?   @db.Text
  // A fingerprint of the tool's inputs, labels, server address and account, made by the bot server. A different one means
  // the tool changed and goes back to not confirmed yet.
  fingerprint     String    @db.VarChar(128)
  // looksUp | makesNew | changesThings | deletesOrSends; where it came from: server | description | builtIn
  suggestedHeading String?  @map("suggested_heading") @db.VarChar(20)
  suggestionSource String?  @map("suggestion_source") @db.VarChar(20)
  // The heading a person chose (or accepted from the suggestion), set when confirmed or moved.
  heading         String?   @db.VarChar(20)
  movedById       String?   @map("moved_by_id")
  confirmedById   String?   @map("confirmed_by_id")
  confirmedAt     DateTime? @map("confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  server      BotMcpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  movedBy     User?        @relation("BotToolMovedBy", fields: [movedById], references: [id], onDelete: SetNull)
  confirmedBy User?        @relation("BotToolConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([serverId, name])
  @@map("bot_mcp_tools")
}

// AI Providers
model BotsAiProvider {
  providerId        String   @id @map("provider_id") @db.VarChar(50)
  name              String   @db.VarChar(255)
  type              String   @db.VarChar(50)
  enabled           Boolean  @default(false)
  endpoint          String?  @db.Text
  apiKeyEncrypted   String?  @map("api_key_encrypted") @db.Text
  model             String?  @db.VarChar(255)
  temperature       Decimal? @db.Decimal(3, 2) @default(0.7)
  maxTokens         Int?     @map("max_tokens") @default(500)
  supportsStreaming Boolean  @default(true) @map("supports_streaming")
  supportsVision    Boolean?  @map("supports_vision") // null=auto (regex), true=force vision, false=force text-only
  visionModel       String?   @map("vision_model") @db.VarChar(255) // model used when this provider describes images
  defaultVision     Boolean   @default(false) @map("default_vision") // preferred vision provider when bots need image descriptions
  settings          Json?    @default("{}")
  tested            Boolean  @default(false)
  testedAt          DateTime? @map("tested_at")
  // Whose key this is (#374). Null = a provider the super admin runs for the whole server, which is every row there was
  // before personal keys. Anything that lists or reads providers for the server must keep only ownerId = null.
  ownerId           String?  @map("owner_id")
  // The last four characters of the key, kept so the owner can recognise it. The key itself is never sent to a browser.
  apiKeyLast4       String?  @map("api_key_last4") @db.VarChar(4)
  // The provider Universe AI runs on (#374). At most one server provider has it (set in one transaction); a bot on
  // Universe AI follows it. Personal keys never have it.
  isDefault         Boolean  @default(false) @map("is_default")
  // Health of a personal key (#374). downSince is set while the key is Down (null = Working). failedReplies counts
  // replies that failed in a row; two mark it Down. ifDown is what the bot does meanwhile: "universe-ai" or "stop".
  downSince         DateTime? @map("down_since")
  downReason        String?  @map("down_reason") @db.VarChar(20)
  failedReplies     Int      @default(0) @map("failed_replies")
  healthCheckedAt   DateTime? @map("health_checked_at")
  ifDown            String   @default("universe-ai") @map("if_down") @db.VarChar(20)
  // A personal key's reply limits (#666), set by its owner: only the ones they changed (lib/bot-limits.ts fills in the
  // rest with the recommended values). A server provider has none: Universe AI's are saved in app_settings.
  replyLimits       Json?    @map("reply_limits")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  owner             User?    @relation("AiKeyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  usage             BotsAiUsage[]
  lends             AiKeyLend[]

  @@index([enabled])
  @@index([type])
  @@index([ownerId])
  @@map("bots_ai_providers")
}

// A person's AI key lent to a universe (#374): bots made there by the key's owner may run on it, and nobody else's may.
// Lending moves no bot; each bot is pointed at the key by its maker on the bot page.
model AiKeyLend {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id") @db.VarChar(50)
  universeId String   @map("universe_id")
  lentAt     DateTime @default(now()) @map("lent_at")
  // Which of the key's models bots in that universe may use (#575): a list of model ids, or null for all of them.
  models     Json?

  provider BotsAiProvider @relation(fields: [providerId], references: [providerId], onDelete: Cascade)
  universe Universe       @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([providerId, universeId])
  @@index([universeId])
  @@map("ai_key_lends")
}

// AI Usage Tracking
model BotsAiUsage {
  id              Int      @id @default(autoincrement())
  botId           String   @map("bot_id") @db.VarChar(255)
  providerId      String   @map("provider_id") @db.VarChar(50)
  tokensUsed      Int      @default(0) @map("tokens_used")
  apiCalls        Int      @default(1) @map("api_calls")
  durationSeconds Int?     @map("duration_seconds")
  // The old estimate (4 decimals, a flat rate on most models). Rows made before the price facts below keep it as it was; new rows leave it empty.
  cost            Decimal? @db.Decimal(10, 4)
  latency         Int?
  error           Boolean  @default(false)
  timestamp       DateTime @default(now())
  // What a reply cost and how that was worked out (game #1173). Empty on rows from before it, which are the "old estimates".
  // Token counts never overlap: inputTokens is input that was neither read from nor written to a cache, outputTokens is
  // answer text without the reasoning part, so the five add up to everything the provider billed.
  inputTokens      Int?    @map("input_tokens")
  cachedTokens     Int?    @map("cached_tokens")
  cacheWriteTokens Int?    @map("cache_write_tokens")
  outputTokens     Int?    @map("output_tokens")
  reasoningTokens  Int?    @map("reasoning_tokens")
  // Millionths of a dollar. Empty when the price is unknown (costBasis 'unknown'); 0 is a real zero (an own computer).
  costMicros       Int?    @map("cost_micros")
  // priced (from the price list), provider (the provider said what it cost), override (a super admin's own rate), own_computer, unknown
  costBasis        String? @map("cost_basis") @db.VarChar(20)
  // Where the prices came from (models.dev, openrouter, ...) and which version of that list, so a cost can be checked by hand later
  priceSource      String? @map("price_source") @db.VarChar(60)
  priceVersion     String? @map("price_version") @db.VarChar(60)
  // Who talked to the bot (#374): the person's id as the bot server knows it; null when it was not told or for older rows
  talkedUserId    String?  @map("talked_user_id") @db.VarChar(255)
  // Whose key paid, when it was a personal key; null for the server's own providers. Set by Orbit, never taken from a request.
  keyOwnerId      String?  @map("key_owner_id")
  // Where the reply was given (Orbit #491): "dm" (direct messages) or "nearby" (nearby chat). Null on rows from before
  // it, which the bot page shows as "Not split".
  channel         String?  @db.VarChar(10)
  // The signed-in person who talked, worked out by Orbit from talkedUserId (Orbit #491, game #1159). Null for a guest,
  // for someone Orbit does not know and for older rows.
  talkedPersonId  String?  @map("talked_person_id")
  // True when a guest talked, false for a signed-in person; null when the bot server did not say (older rows)
  talkedGuest     Boolean? @map("talked_guest")
  // A greeting the bot made on its own when someone walked up. It is paid for by whoever's key the bot runs on and reported as
  // usage, but it is never counted against the person it greeted: not in their Universe AI window, not in a bot's own limit per
  // person and not in the guests' pool.
  greeting        Boolean  @default(false)

  provider        BotsAiProvider @relation(fields: [providerId], references: [providerId], onDelete: Cascade)
  talkedPerson    User?          @relation("UsageTalkedPerson", fields: [talkedPersonId], references: [id], onDelete: SetNull)

  @@index([botId])
  @@index([providerId])
  @@index([timestamp])
  @@index([botId, providerId, timestamp])
  @@index([talkedPersonId, timestamp])
  @@index([talkedUserId, timestamp])
  @@map("bots_ai_usage")
}

// A reply limit's window (game #1159): when it started for one person, or for all guests on one bot. A window starts at
// the first reply asked for once the last one has ended, and lasts 5 hours (Universe AI) or 24 hours (a bot's own limit).
// The replies in it are counted from usage rows; this only remembers where it starts.
model ReplyWindow {
  // "ua:person:<user id>", "ua:guest:<their id>", "ua:guests:<bot id>" or "bot:<bot id>:<person or guest>"
  key       String   @id @db.VarChar(320)
  startedAt DateTime @map("started_at")

  @@map("reply_windows")
}

// A spoken reply counted against a person's Universe AI window (game #1669). One row per reply, keyed by the turn the bot
// server gives it, so asking again for the same reply (a retry, a reconnect) never counts it twice. Whether the text of the
// reply counted is in the usage rows as ever; this only says which replies were also spoken.
model VoiceReplyUse {
  id        String   @id @default(uuid())
  botId     String   @map("bot_id")
  // The reply's turn as the bot server names it
  turnId    String   @map("turn_id") @db.VarChar(255)
  // "person:<user id>" or "guest:<their id>", the same words the Universe AI reply window is kept under
  personKey String   @map("person_key") @db.VarChar(320)
  createdAt DateTime @default(now()) @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, turnId])
  @@index([personKey, createdAt])
  @@map("voice_reply_uses")
}

// Seconds a bot listened for its name in a day, all the people near it together (game #1859). One row per bot and UTC day; the bot
// server adds the audio of group speech that was not said to the bot, and the day's limit is the voice limit "listen minutes a day"
// (#740, or the one a lent listening key sets, #783). Old days are never read again.
model VoiceListenUse {
  botId     String   @map("bot_id")
  // The UTC day, as a date
  day       DateTime @db.Date
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@id([botId, day])
  @@map("voice_listen_uses")
}

// Someone reached a reply limit on a bot (game #1159, Orbit #491): once per person, limit and window. The bot page counts
// these as "people ran out"; who they were is never shown for them.
model BotReplyLimitHit {
  id           String   @id @default(uuid())
  botId        String   @map("bot_id")
  // "universe-ai" (signed in), "guest" (a guest's own 10), "guests" (the bot's shared guest pool) or "bot" (its own limit)
  kind         String   @db.VarChar(20)
  // The person or guest as the bot server knows them
  talkedUserId String   @map("talked_user_id") @db.VarChar(255)
  windowEndsAt DateTime @map("window_ends_at")
  // When they tapped "Ask <bot>'s maker" on the limit card (game #1159 step 3); the maker sees how many asked, never who
  askedAt      DateTime? @map("asked_at")
  createdAt    DateTime @default(now()) @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, kind, talkedUserId, windowEndsAt])
  @@index([botId, createdAt])
  @@map("bot_reply_limit_hits")
}

// The meter's books (game #1998, Brick 7). Our own count of everything that costs money: one row per app use, model call,
// computer minute, size change and stored byte, written once under an event id, against a person, a Brick and a payer.
// It runs in shadow first: it records and is compared with today's counts and the provider's figures, and enforces nothing
// new. No foreign keys on purpose: the books keep what happened after a person, a bot or a Brick is deleted.
model MeterEvent {
  id            String    @id @default(uuid())
  // What makes a write "once": a retry of the same event finds this row and writes nothing
  eventId       String    @unique @map("event_id") @db.VarChar(255)
  // model_call, speech, app_use, computer_time, size_change, stored_bytes
  kind          String    @db.VarChar(20)
  // "chat" (replies and voice) or "computer" (what a Brick's computer costs); the two are kept apart
  pool          String    @db.VarChar(10)
  occurredAt    DateTime  @map("occurred_at")
  recordedAt    DateTime  @default(now()) @map("recorded_at")
  // Who asked: "person:<user id>", "guest:<their id>" (the same words reply windows use) or "unknown"
  personKey     String    @map("person_key") @db.VarChar(320)
  personId      String?   @map("person_id")
  // The bot that did it, and whether it was a Brick (no room) at the time; null when the bot was not found
  botId         String?   @map("bot_id")
  brick         Boolean?
  // Who pays: "universe" (we do), "person" (the owner of a key or of a connected app) or "unknown"
  payerKind     String    @map("payer_kind") @db.VarChar(10)
  payerPersonId String?   @map("payer_person_id")
  // The route it took: universe-ai, provider, own-key, app, computer
  route         String?   @db.VarChar(40)
  // The job it belongs to, for work a computer does
  jobId         String?   @map("job_id") @db.VarChar(255)
  quantity      BigInt
  // call, token, second, minute, byte, use, reply
  unit          String    @db.VarChar(12)
  // Millionths of a dollar. Empty when the price is unknown; 0 is a real zero
  costMicros    BigInt?   @map("cost_micros")
  // measured, estimated, paid_by_other (someone else's bill) or unknown
  basis         String    @db.VarChar(16)
  // When the provider's settlement covered it; empty until then (the envelope keeps room for what is not settled yet)
  settledAt     DateTime? @map("settled_at")
  // Where it was copied from, such as "bots_ai_usage:123", so the books can be compared with that source
  sourceRef     String?   @map("source_ref") @db.VarChar(255)
  detail        Json?

  @@index([personKey, occurredAt])
  @@index([botId, occurredAt])
  @@index([pool, kind, occurredAt])
  @@index([sourceRef])
  @@map("meter_events")
}

// Room kept for a paid step before it is taken (game #1998): against the member's allowance and our own pool. A long job renews
// it while it runs. One row per key, so asking again for the same step finds the same room. A reservation never goes away; it
// ends as settled (the step ran) or released (it never ran), so what happened stays in the books.
model MeterReservation {
  id             String    @id @default(uuid())
  reservationKey String    @unique @map("reservation_key") @db.VarChar(255)
  personKey      String    @map("person_key") @db.VarChar(320)
  personId       String?   @map("person_id")
  botId          String?   @map("bot_id")
  jobId          String?   @map("job_id") @db.VarChar(255)
  amountMicros   BigInt    @map("amount_micros")
  // held, settled or released
  state          String    @db.VarChar(10)
  expiresAt      DateTime  @map("expires_at")
  renewals       Int       @default(0)
  settledMicros  BigInt?   @map("settled_micros")
  createdAt      DateTime  @default(now()) @map("created_at")
  closedAt       DateTime? @map("closed_at")

  @@index([personKey, state])
  @@index([state, expiresAt])
  @@map("meter_reservations")
}

// Extra usage given to a member (game #1998): recorded once under its key, so a retry or a second super admin never gives
// it twice. A gift is free to the person and never owed; extra usage to be billed records something agreed with the person
// before it was given, outside the product, and says when it was billed. The two are never the same row kind.
model MeterGrant {
  id          String    @id @default(uuid())
  grantKey    String    @unique @map("grant_key") @db.VarChar(255)
  personId    String    @map("person_id")
  // gift or to_bill
  settlement  String    @db.VarChar(10)
  // 2 for double, 5 for five times; empty when it lifts the member's own limit
  multiplier  Int?
  noLimit     Boolean   @default(false) @map("no_limit")
  // What it covers; chat, voice and computer time are raised together
  covers      String    @default("all") @db.VarChar(20)
  startsAt    DateTime  @map("starts_at")
  endsAt      DateTime  @map("ends_at")
  givenById   String    @map("given_by_id")
  // What was agreed, for extra usage to be billed
  note        String?   @db.VarChar(1000)
  billedAt    DateTime? @map("billed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([personId, endsAt])
  @@map("meter_grants")
}

// A member's "Ask for more" (game #1999): what a person tapped when their computer time ran out. Only a request: it is not a
// debt and not a grant, and it makes nothing for anyone to pay. One is open for a person at a time (a second tap finds it);
// giving extra usage answers it. Nothing a person says is kept here, only that they asked and when.
model MeterRequest {
  id         String    @id @default(uuid())
  personId   String    @map("person_id")
  // What ran out. Computer time is the only thing a member asks for more of; chat and voice keep their own fair usage.
  what       String    @default("computer") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at")
  answeredAt DateTime? @map("answered_at")
  // The extra usage that answered it
  grantKey   String?   @map("grant_key") @db.VarChar(255)

  // The migration also makes a partial unique index (one open request per person and thing: person_id, what WHERE answered_at
  // IS NULL), which Prisma cannot write here. The code does not need it to be right, it only closes the same-moment race.
  @@index([personId, answeredAt])
  @@map("meter_requests")
}

// Bot Metrics
model BotsMetric {
  id          Int      @id @default(autoincrement())
  botId       String   @map("bot_id") @db.VarChar(255)
  metricType  String   @map("metric_type") @db.VarChar(50)
  metricValue Decimal  @map("metric_value") @db.Decimal(15, 4)
  metadata    Json?
  timestamp   DateTime @default(now())

  @@index([botId, timestamp])
  @@index([metricType, timestamp])
  @@index([timestamp])
  @@map("bots_metrics")
}

// Bot Conversations
model BotsConversation {
  id           Int      @id @default(autoincrement())
  botId        String   @map("bot_id") @db.VarChar(255)
  userUuid     String?  @map("user_uuid") @db.VarChar(255)
  userId       String?  @map("user_id")
  userName     String?  @map("user_name") @db.VarChar(255)
  isGuest      Boolean  @default(true) @map("is_guest")
  messages     Json
  startedAt    DateTime @map("started_at")
  endedAt      DateTime @map("ended_at")
  messageCount Int      @map("message_count")
  endReason    String?  @map("end_reason") @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([botId, createdAt])
  @@index([userUuid])
  @@index([userId])
  @@index([createdAt])
  @@index([endedAt])
  @@map("bots_conversations_recent")
}

// Bot Test Results
model BotsTestResult {
  id        Int      @id @default(autoincrement())
  testId    String   @unique @map("test_id") @db.VarChar(255)
  botId     String?  @map("bot_id") @db.VarChar(255)
  testSuite String?  @map("test_suite") @db.VarChar(255)
  results   Json
  passed    Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([botId])
  @@index([testSuite])
  @@index([createdAt])
  @@map("bots_test_results")
}

// Someone the owner asked a bot to forget (#435). The bot server keeps what it remembers in memory and saves all of it
// every few minutes, so deleting the saved rows is not enough: the next save would bring them back. This row makes the
// save endpoint skip the person (userUuid null = everyone) and tell the bot server to drop them. It is kept a minute
// after it was told, in case the answer was lost, then removed.
model BotMemoryForget {
  id         String    @id @default(uuid())
  botId      String    @map("bot_id") @db.VarChar(255)
  userUuid   String?   @map("user_uuid") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at")
  reportedAt DateTime? @map("reported_at")

  @@index([botId])
  @@map("bot_memory_forgets")
}

// One thing a person asked a bot to forget (game #2003), as the key of what it said (a hash: the words themselves are
// never kept). It stays for good: every memory save and read takes a thing with this key out again, so a copy the bot
// server still holds, an old row that is restored, or the same words found in older history never bring it back. Only
// the person saying it again afterwards is learned again. `droppedAt` is when the bot server reported it dropped the thing
// from what it keeps in memory; until then Orbit keeps telling it.
model BotMemoryItemForget {
  id        String    @id @default(uuid())
  botId     String    @map("bot_id") @db.VarChar(255)
  userUuid  String    @map("user_uuid") @db.VarChar(255)
  itemKey   String    @map("item_key") @db.VarChar(64)
  kind      String    @db.VarChar(10)
  createdAt DateTime  @default(now()) @map("created_at")
  droppedAt DateTime? @map("dropped_at")

  @@unique([botId, userUuid, itemKey])
  @@index([botId, droppedAt])
  @@map("bot_memory_item_forgets")
}

// Files in bot chats (game #1508): what a person sent a bot and what a bot sent them, so the bot can find, read and send
// them again later instead of forgetting them once the message has passed. Artifacts are not copied here: they have their
// own tables, and the bot finds them there. A file belongs to the person who sent it or who the bot made it for; others
// may use it only while they are in the chat it came in. A guest's goes after a day, like a guest's artifact. No Orbit
// page lists these: only the bot server reaches them.
model BotFile {
  id        String    @id @default(uuid())
  botId     String    @map("bot_id")
  // The bot's short id for it: f12 is number 12. One count per bot, so two people in a bubble never share an id.
  number    Int
  // The person it belongs to; null for a guest
  ownerId   String?   @map("owner_id")
  // The person as the bot server named them (their game uuid), so Forget also finds a guest's files
  personRef String?   @map("person_ref") @db.VarChar(320)
  // person (they sent it) | bot (the bot sent it)
  source    String    @db.VarChar(10)
  // image | audio | video | document | other
  kind      String    @db.VarChar(20)
  name      String    @db.VarChar(255)
  mimeType  String?   @map("mime_type") @db.VarChar(255)
  sizeBytes Int?      @map("size_bytes")
  // How to open it again later. A chat bucket and the uploader's id (opened through the uploader's /chat-file link), or a
  // link that lasts (the uploader's own /upload-file link, or a bucket's public link). Never a signed link: those expire.
  bucket    String?   @db.VarChar(255)
  fileId    String?   @map("file_id") @db.VarChar(255)
  url       String?   @db.VarChar(2048)
  // One line about it, for the bot's notes and for search
  line      String?   @db.VarChar(300)
  // For a file a bot made: the tool it used and what it asked that tool for, so it can make one like it again
  madeWith  String?   @map("made_with") @db.VarChar(100)
  madePrompt String?  @map("made_prompt")
  // How long a song, voice note or video is, and how many pages a document has, when known
  lengthSeconds Int?  @map("length_seconds")
  pages     Int?
  // The chat it came in: nearby | dm, and the id the bot server uses for it
  chatKind  String    @map("chat_kind") @db.VarChar(20)
  chatRef   String    @map("chat_ref") @db.VarChar(255)
  // Everyone who was in the chat when it was put there, the sender included, by the ids the bot server names people by
  // (game #1993). A reply other people read uses it only when all of them are in this list. Empty: nobody was recorded.
  seenBy    String[]  @default([]) @map("seen_by")
  // The text kept from it: none (not read, or nothing to read) | reading (pieces still coming) | kept | failed
  textState String    @default("none") @map("text_state") @db.VarChar(10)
  textChars Int       @default(0) @map("text_chars")
  // Set for a guest's file: when it goes
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  bot   Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  owner User?         @relation("BotFileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parts BotFilePart[]

  @@unique([botId, number])
  @@index([botId, ownerId, createdAt])
  @@index([botId, chatKind, chatRef])
  @@index([botId, personRef])
  @@index([expiresAt])
  @@map("bot_files")
}

// A file its person deleted from a Brick's list (game #2003), waiting for the bot server to remove it from the uploader.
// Orbit cannot reach the uploader, so the row stays until the bot server has confirmed, and a restart never forgets one.
// Only where the file is, never what it was called or said.
model BotFileRemoval {
  id        String   @id @default(uuid())
  botId     String   @map("bot_id") @db.VarChar(255)
  bucket    String   @db.VarChar(255)
  fileId    String   @map("file_id") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bucket, fileId])
  @@index([createdAt])
  @@map("bot_file_removals")
}

// The text kept from a file, in parts in order, so a long document is searched by its words and read a part at a time.
// `words` is worked out by Postgres from the text when a part is saved (Postgres's own word index, no extension), with
// text in its composed form (NFC) and Arabic short vowels and tatweel left out, so a search finds the words with or without
// them or with accents typed apart, and split at punctuation as a search is. The same expression as the migration's; keep them the same.
model BotFilePart {
  botFileId String @map("bot_file_id")
  number    Int
  // Where this part starts in the file's text, in characters
  start     Int
  text      String
  words     Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, regexp_replace(regexp_replace(NORMALIZE(text, NFC), '[\\u0610-\\u061A\\u0640\\u064B-\\u065F\\u0670\\u06D6-\\u06ED]'::text, ''::text, 'g'::text), '[\\u0021-\\u002F\\u003A-\\u0040\\u005B-\\u0060\\u007B-\\u007E\\u00A1\\u00AB\\u00B7\\u00BB\\u00BF\\u060C\\u061B\\u061F\\u066A-\\u066C\\u06D4\\u2000-\\u206F\\u3000-\\u3003\\u3008-\\u3011\\u3014-\\u301F\\uFF01-\\uFF0F\\uFF1A-\\uFF20\\uFF3B-\\uFF40\\uFF5B-\\uFF65]'::text, ' '::text, 'g'::text))"))

  file BotFile @relation(fields: [botFileId], references: [id], onDelete: Cascade)

  @@id([botFileId, number])
  @@index([words], map: "bot_file_parts_words_idx", type: Gin)
  @@map("bot_file_parts")
}

// The last short id a bot gave a file, counted up in one statement so two files added at once never get the same one.
model BotFileCounter {
  botId String @id @map("bot_id")
  last  Int    @default(0)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_file_counters")
}

// Bot Memory
model BotsMemory {
  id              Int       @id @default(autoincrement())
  botId           String    @map("bot_id") @db.VarChar(255)
  userUuid        String    @map("user_uuid") @db.VarChar(255)
  userId          String?   @map("user_id")
  userName        String?   @map("user_name") @db.VarChar(255)
  isGuest         Boolean   @default(true) @map("is_guest")
  memories        Json?
  emotions        Json?
  lastEmotionUpdate DateTime? @map("last_emotion_update")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([botId, userUuid])
  @@index([botId])
  @@index([userUuid])
  @@index([userId])
  @@map("bots_memory")
}

// =============================================================================
// AVATAR CATALOG SYSTEM
// =============================================================================

// AvatarSet — a named, publishable group of woka layers and/or companions.
// visibility:
//   "public"       -> shown to all eligible players in picker
//   "hidden"       -> never shown in picker; bots/direct assignment only
//   "restricted"   -> shown only to players who have a matching entitlement
//   "assigned_only"-> never in picker; only usable via direct UserAvatarGrant
//
// scopeType (on AvatarSetScope):
//   "platform"  -> available across all universes/worlds
//   "universe"  -> available inside one universe
//   "world"     -> available inside one world
model AvatarSet {
  id          String   @id @default(uuid())
  slug        String   @unique // e.g. "default", "zoo-animals", "museum-staff"
  name        String
  description String?

  // What kind of assets this set provides
  // "woka" | "companion" | "mixed"
  kind        String   @default("woka")

  // Lifecycle: "draft" | "active" | "archived"
  lifecycle   String   @default("draft")

  // Who sees this in the player picker
  // "public" | "hidden" | "restricted" | "assigned_only"
  visibility  String   @default("public")

  // Commercial / ownership metadata (for future monetisation)
  // "platform" | "partner" | "internal" | "client"
  sourceOwnerType  String  @default("platform") @map("source_owner_type")
  partnerRef       String? @map("partner_ref")       // external partner/client id
  campaignCode     String? @map("campaign_code")
  // "free" | "subscription" | "purchase" | "sponsored" | "custom_contract"
  monetizationType String  @default("free") @map("monetization_type")
  billingReference String? @map("billing_reference")
  licenseNotes     String? @map("license_notes")

  // Availability window (null = no limit)
  availableFrom DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")

  // Display order in admin and picker
  position    Int      @default(0)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  layers       AvatarLayer[]
  companions   AvatarCompanion[]
  scopes       AvatarSetScope[]
  policies     AvatarEntitlementPolicy[]
  userGrants   UserAvatarGrant[]

  @@index([lifecycle, visibility])
  @@map("avatar_sets")
}

// AvatarLayer — a single texture asset belonging to a set.
// layer values mirror the woka.json top-level keys:
//   "woka" | "body" | "eyes" | "hair" | "clothes" | "hat" | "accessory"
model AvatarLayer {
  id          String  @id @default(uuid())
  avatarSetId String  @map("avatar_set_id")

  // The texture ID used by WorkAdventure (e.g. "male1", "hair23")
  textureId   String  @map("texture_id")

  // Which customisation layer this belongs to
  layer       String  // "woka"|"body"|"eyes"|"hair"|"clothes"|"hat"|"accessory"

  name        String?
  // Full URL or play-relative path — stored as-is, resolved at runtime
  url         String
  position    Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  avatarSet   AvatarSet @relation(fields: [avatarSetId], references: [id], onDelete: Cascade)

  @@unique([avatarSetId, textureId])
  @@index([avatarSetId, layer])
  @@index([textureId])
  @@map("avatar_layers")
}

// AvatarCompanion — a companion asset belonging to a set.
model AvatarCompanion {
  id          String  @id @default(uuid())
  avatarSetId String  @map("avatar_set_id")
  textureId   String  @map("texture_id")
  name        String?
  url         String
  behavior    String? // optional WA companion behavior hint
  position    Int     @default(0)
  isActive    Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  avatarSet   AvatarSet @relation(fields: [avatarSetId], references: [id], onDelete: Cascade)

  @@unique([avatarSetId, textureId])
  @@index([avatarSetId])
  @@map("avatar_companions")
}

// AvatarSetScope — controls WHERE a set is available.
// scopeType "platform" -> scopeId = "" (global, no specific scope)
// scopeType "universe" -> scopeId = Universe.id
// scopeType "world"    -> scopeId = World.id
model AvatarSetScope {
  id          String  @id @default(uuid())
  avatarSetId String  @map("avatar_set_id")
  scopeType   String  @map("scope_type") // "platform" | "universe" | "world"
  scopeId     String  @default("") @map("scope_id") // "" for platform scope

  // Optional: a direct World FK so Prisma can validate world-level scopes
  worldId     String? @map("world_id")

  avatarSet   AvatarSet @relation(fields: [avatarSetId], references: [id], onDelete: Cascade)
  world       World?    @relation(fields: [worldId], references: [id], onDelete: Cascade)

  @@unique([avatarSetId, scopeType, scopeId])
  @@index([avatarSetId])
  @@index([scopeType, scopeId])
  @@map("avatar_set_scopes")
}

// AvatarEntitlementPolicy — defines WHO can use a restricted/assigned set.
// subjectType:
//   "everyone"         -> all authenticated users (useful with restricted + world scope)
//   "membership_tag"   -> WorldMembers with matching tag (most common for staff/VIP)
//   "user"             -> specific User.id
//   "email_domain"     -> e.g. "@company.com"
//   "subscription_plan"-> for future paid club feature
//   "external_contract"-> for partner API grants
model AvatarEntitlementPolicy {
  id          String  @id @default(uuid())
  avatarSetId String  @map("avatar_set_id")

  subjectType  String  @map("subject_type")
  subjectValue String? @map("subject_value") // tag name, user id, domain, plan id, etc.

  // What the subject can do:
  // "select"         -> can pick in player woka picker
  // "assign_to_bot"  -> admin can assign to bots
  // "manage"         -> full admin control over the set
  action      String  @default("select")

  // Optional world scope override for tag-based policies
  worldId     String? @map("world_id")

  isActive    Boolean @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  avatarSet   AvatarSet @relation(fields: [avatarSetId], references: [id], onDelete: Cascade)

  @@index([avatarSetId])
  @@index([subjectType, subjectValue])
  @@map("avatar_entitlement_policies")
}

// UserAvatarGrant — direct per-user grants (overrides visibility rules).
// Use for: celebrity custom character, contest winner, support/gift grants.
model UserAvatarGrant {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  avatarSetId String   @map("avatar_set_id")

  // "select" | "assigned_only" (admin forced their outfit)
  grantType   String   @default("select") @map("grant_type")

  // Optional note for audit purposes (e.g. "Contest winner May 2026")
  note        String?

  expiresAt   DateTime? @map("expires_at") // null = permanent
  grantedAt   DateTime  @default(now()) @map("granted_at")
  revokedAt   DateTime? @map("revoked_at")
  isActive    Boolean   @default(true) @map("is_active")

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarSet   AvatarSet @relation(fields: [avatarSetId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([avatarSetId])
  @@map("user_avatar_grants")
}

// AvatarSetAuditLog — immutable audit trail for all catalog changes.
// avatarSetId is a plain field (no FK constraint) so audit records survive the
// deletion of the set they reference.
model AvatarSetAuditLog {
  id          Int      @id @default(autoincrement())
  avatarSetId String   @map("avatar_set_id")
  actorId     String?  @map("actor_id") // User.id who made the change

  // e.g. "set.created", "set.published", "set.archived",
  //      "layer.added", "layer.removed", "scope.added",
  //      "policy.added", "policy.removed", "grant.issued", "grant.revoked"
  action      String

  // JSON snapshot of what changed: { before: {...}, after: {...} }
  diff        Json?

  createdAt   DateTime @default(now()) @map("created_at")

  // actor relation preserved — audit logs still reference the user who acted
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([avatarSetId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("avatar_set_audit_logs")
}

// A bot action that waits for a tap, kept so the tap runs it once, survives a restart and never runs twice (#739).
// Redis may carry notices about it but is never the record. Status: waiting | approved | running | done | failed |
// couldntConfirm | closed (with closedReason: declined | superseded | expired | stale | cancelled | revoked). Every change
// is a conditional update on the status and revision the caller saw, so one tap wins. The tap names only this row's id and
// revision, never new content: `arguments` is what was shown and what runs.
model BotActionRequest {
  id              String    @id @default(uuid())
  botId           String    @map("bot_id")
  // The bot server's own key for this request (its job, turn and tool call), so a retried save does not make a second card.
  proposalKey     String    @map("proposal_key") @db.VarChar(200)
  // Who asked, as the bot server authenticated them (the signed-in account, or the guest's server session), and which
  // conversation (the bubble or the direct-message thread) the card is in. Only the asker's tap counts.
  requesterKey    String    @map("requester_key") @db.VarChar(400)
  conversationKey String    @map("conversation_key") @db.VarChar(400)
  connectionRef   String?   @map("connection_ref") @db.VarChar(200)
  toolName        String    @map("tool_name") @db.VarChar(255)
  // makesNew | changesThings | deletesOrSends | looksUp: the heading the tool was confirmed under
  heading         String    @db.VarChar(20)
  toolFingerprint String    @map("tool_fingerprint") @db.VarChar(128)
  policyRevision  Int       @map("policy_revision")
  // The exact approved arguments as JSON, encrypted like a key, and a digest of them for comparing.
  arguments       String    @db.Text
  argumentsDigest String    @map("arguments_digest") @db.VarChar(64)
  // What "allow more" would remember if tapped, fixed by the bot server when it makes the card; null = not offered.
  rememberScope   Json?     @map("remember_scope")
  status          String    @default("waiting") @db.VarChar(20)
  closedReason    String?   @map("closed_reason") @db.VarChar(20)
  // Goes up with every change; a tap carries the one it saw.
  revision        Int       @default(1)
  // The card stops waiting here (server clock).
  reviewExpiresAt DateTime  @map("review_expires_at")
  approvedAt      DateTime? @map("approved_at")
  // An approved action must be claimed by here or it needs a fresh card.
  startBy         DateTime? @map("start_by")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  bot       Bot                  @relation(fields: [botId], references: [id], onDelete: Cascade)
  decisions BotActionDecision[]
  attempts  BotActionAttempt[]

  @@unique([botId, proposalKey])
  @@index([botId, conversationKey, status])
  @@index([status, reviewExpiresAt])
  @@map("bot_action_requests")
}

// What happened to a request, in order: who decided what, and what closed or moved it. No card text.
model BotActionDecision {
  id           String   @id @default(uuid())
  requestId    String   @map("request_id")
  // approve | approveAndRemember | decline | supersede | expire | stale | cancel | extend | revoke | claim | reconcile
  event        String   @db.VarChar(24)
  actorKey     String?  @map("actor_key") @db.VarChar(400)
  fromRevision Int      @map("from_revision")
  toRevision   Int      @map("to_revision")
  createdAt    DateTime @default(now()) @map("created_at")

  request BotActionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("bot_action_decisions")
}

// One try to run an approved request. state: claimed | succeeded | failed | notSent | uncertain. At most one attempt per
// request is claimed at a time (a unique index in the migration). An uncertain attempt is never sent again by itself.
model BotActionAttempt {
  id                String    @id @default(uuid())
  requestId         String    @map("request_id")
  attemptNo         Int       @map("attempt_no")
  state             String    @default("claimed") @db.VarChar(16)
  // The same for every attempt of a request, for destinations that deduplicate.
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(100)
  providerRequestId String?   @map("provider_request_id") @db.VarChar(200)
  // A short word for the result or error class, never the content.
  outcomeClass      String?   @map("outcome_class") @db.VarChar(60)
  claimedAt         DateTime  @default(now()) @map("claimed_at")
  leaseExpiresAt    DateTime  @map("lease_expires_at")
  finishedAt        DateTime? @map("finished_at")

  request BotActionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, attemptNo])
  @@map("bot_action_attempts")
}

// A remembered approval (#739): "Create, and allow more WEB issues in this chat". Bound to the asker, the bot, the
// conversation, the connection, the reviewed tool and its policy revision, with the arguments that stay fixed and the
// fields that may vary. Never for deletes or sends. It ends after idleMinutes without the asker's messages, absoluteMinutes
// at most, or when revoked.
model BotActionGrant {
  id               String    @id @default(uuid())
  botId            String    @map("bot_id")
  requesterKey     String    @map("requester_key") @db.VarChar(400)
  conversationKey  String    @map("conversation_key") @db.VarChar(400)
  connectionRef    String?   @map("connection_ref") @db.VarChar(200)
  toolName         String    @map("tool_name") @db.VarChar(255)
  heading          String    @db.VarChar(20)
  toolFingerprint  String    @map("tool_fingerprint") @db.VarChar(128)
  policyRevision   Int       @map("policy_revision")
  // { fixed: { field: value }, varies: [field] }
  scope            Json
  fromRequestId    String?   @map("from_request_id") @db.VarChar(100)
  idleMinutes      Int       @map("idle_minutes")
  idleExpiresAt    DateTime  @map("idle_expires_at")
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason") @db.VarChar(40)
  createdAt        DateTime  @default(now()) @map("created_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, requesterKey, conversationKey])
  @@map("bot_action_grants")
}

// Voice providers (#740): the speech companies a super admin has set up for the whole server, for listening (recognition),
// for speaking (speech), or both. Which adapter runs one is the bot server's business; Orbit keeps what to call, where to
// reach and with which key. The key is encrypted and never sent to a browser. At most one provider is the default for each of
// the two jobs (set in one transaction); a bot on Universe AI follows them.
model VoiceProvider {
  id                 String   @id @default(uuid())
  // The adapter the bot server runs this with: a short name such as "elevenlabs"
  adapter            String   @db.VarChar(50)
  name               String   @db.VarChar(255)
  recognition        Boolean  @default(false)
  speech             Boolean  @default(false)
  enabled            Boolean  @default(false)
  endpoint           String?  @db.Text
  region             String?  @db.VarChar(50)
  apiKeyEncrypted    String?  @map("api_key_encrypted") @db.Text
  // The last four characters of the key, kept so a super admin can recognise it
  apiKeyLast4        String?  @map("api_key_last4") @db.VarChar(4)
  // The models it can be used with: [{ id, label, kind: "recognition" | "speech" }]
  models             Json     @default("[]")
  defaultRecognition Boolean  @default(false) @map("default_recognition")
  defaultSpeech      Boolean  @default(false) @map("default_speech")
  // The voice Universe AI speaks with when this is the default speaking provider and a bot is turned on without a key of its own
  // (game #1668); null = the first voice the provider lists. Only a provider that speaks has one.
  defaultVoiceId     String?  @map("default_voice_id") @db.VarChar(255)
  defaultVoiceName   String?  @map("default_voice_name") @db.VarChar(255)
  createdById        String?  @map("created_by_id")
  // Whose key this is (#749). Null = a provider the super admin runs for the whole server, which is every row there was before
  // personal voice keys. Anything that lists or reads providers for the server must keep only ownerId = null.
  ownerId            String?  @map("owner_id")
  // Health of a person's key (#749). downSince is set while the key is Down (null = Working); downReason is why ("credit",
  // "rejected", "errors", "model", "stopped"). failedRecognition and failedSpeech count the calls of each job that failed in a row (a call that works for one job
  // does not clear the other's); two mark the key Down, and downPart says which job ("recognition", "speech"; null when the
  // provider turned the whole key away). A Down key is
  // tried again at most every 5 minutes: healthCheckedAt is when it last was. Server providers have none of this.
  downSince          DateTime? @map("down_since")
  downReason         String?  @map("down_reason") @db.VarChar(20)
  downPart           String?  @map("down_part") @db.VarChar(12)
  failedRecognition  Int      @default(0) @map("failed_recognition")
  failedSpeech       Int      @default(0) @map("failed_speech")
  healthCheckedAt    DateTime? @map("health_checked_at")
  // The limits its owner changed for bots that use their key (#783): only the values they set (turnSeconds, replyCharacters, replySeconds,
  // listenMinutesPerDay); anything not there follows the server's voice limits. Null = none changed.
  voiceLimits        Json?    @map("voice_limits")
  // The models taken off by hand (["kind:id"]): the company's own list is read with the key and every model it lists is added on its
  // own, except these. Adding one back by hand takes it off this list. Null = none taken off.
  hiddenModels       Json?    @map("hidden_models")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  owner User?           @relation("VoiceKeyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  lends VoiceKeyLend[]
  usage VoiceKeyUsage[]

  @@index([enabled])
  @@index([ownerId])
  @@map("voice_providers")
}

// A person's voice key lent to a universe (#749): bots made there by the key's owner may speak or listen with it, and nobody
// else's may. Lending moves no bot; each bot is pointed at the key by its maker in its voice profile. `models` says which of
// the key's models bots there may use, as "kind:id" (e.g. "speech:eleven_flash_v2_5"), or null for all of them.
model VoiceKeyLend {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  universeId String   @map("universe_id")
  lentAt     DateTime @default(now()) @map("lent_at")
  models     Json?

  provider VoiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  universe Universe      @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([providerId, universeId])
  @@index([universeId])
  @@map("voice_key_lends")
}

// How many voice replies a person's voice key paid for in one month (#749), per bot, for "This month" on the AI keys page. The
// bot server counts one when it reports a speaking call that worked and names the bot (POST /api/voice/providers/:id/health).
// `month` is the first day of the month, UTC, the same month as a text key's usage.
model VoiceKeyUsage {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  botId      String   @map("bot_id")
  month      DateTime @db.Date
  replies    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  provider VoiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bot      Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([providerId, botId, month])
  @@index([providerId, month])
  @@map("voice_key_usage")
}

// A bot's voice profile (#740). The draft is what a person is editing; a published revision never changes. A bot speaks with
// the revision named in bots.voice_revision, so publishing and rolling back only move that number.
model BotVoiceDraft {
  botId       String   @id @map("bot_id")
  profile     Json     @default("{}")
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("bot_voice_drafts")
}

model BotVoiceRevision {
  id            String   @id @default(uuid())
  botId         String   @map("bot_id")
  // 1, 2, 3 ... for this bot
  number        Int
  profile       Json
  note          String?  @db.VarChar(500)
  publishedById String?  @map("published_by_id")
  publishedAt   DateTime @default(now()) @map("published_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, number])
  @@map("bot_voice_revisions")
}

// A Brick's computer (game #2000): one lasting computer per Brick, never copied, replaced or reset as a side effect. The row
// exists once its owner gave the Brick a computer; the machine itself is only made at the first real need (`machine` is
// "none" until then). `enabled` false is "Turn off computer": the row and its files stay, nothing runs and nothing is
// counted. There is no per-person switch anywhere: every member may give a Brick a computer, inside their allowance.
model BrickComputer {
  id            String    @id @default(uuid())
  botId         String    @unique @map("bot_id")
  enabled       Boolean   @default(true)
  // none (not made yet), waking, resting, working, cold (resting a long while), broken, restoring, stopped (stopped by us)
  machine       String    @default("none") @db.VarChar(10)
  // Which provider holds the machine: "fake" (the pretend one, for tests and the dev server) or "real" (off until Khalid says)
  provider      String    @default("fake") @db.VarChar(10)
  providerRef   String?   @map("provider_ref") @db.VarChar(255)
  madeAt        DateTime? @map("made_at")
  lastWorkedAt  DateTime? @map("last_worked_at")
  // The last saved copy of its home folder: what Files shows when Computer is off, and which day a restore came from
  filesBytes    BigInt    @default(0) @map("files_bytes")
  filesSavedAt  DateTime? @map("files_saved_at")
  restoredFrom  DateTime? @map("restored_from")
  // Set while a rest is claimed and not finished, empty once it is done: a rest a stopped server left half way is told apart from a finished one
  restClaimedAt DateTime? @map("rest_claimed_at")
  // The last ended job whose notice ("stopped waiting for you", "this month ran out") the person dismissed: it is shown once, never again
  noticeDismissedJobId String? @map("notice_dismissed_job_id") @db.VarChar(40)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("brick_computers")
}

// One job on a Brick's computer (game #2000). Jobs for a Brick queue; the database holds at most one WRITING job running or
// waiting for its person at a time (computer_jobs_one_writer), so two jobs started at the same moment can never both write.
// Only work proven read-only (`writes` false) may overlap.
model ComputerJob {
  id             String    @id @default(uuid())
  botId          String    @map("bot_id")
  personId       String    @map("person_id")
  title          String    @db.VarChar(200)
  // queued, running, waiting (for its person), done, stopped, failed
  status         String    @default("queued") @db.VarChar(10)
  // Why a queued job is not running yet: turn (another job is writing), allowance (the person's own is used up), busy, pool
  queuedFor      String?   @map("queued_for") @db.VarChar(10)
  // Why it stopped: person, allowance, pool, off, deleted, error, unanswered (nobody took over in time)
  endedBy        String?   @map("ended_by") @db.VarChar(10)
  writes         Boolean   @default(true)
  stepDone       Int       @default(0) @map("step_done")
  stepTotal      Int?      @map("step_total")
  stepLabel      String?   @map("step_label") @db.VarChar(200)
  // What it waits for: details, signin, upload, pay, submit or answer
  waitingFor     String?   @map("waiting_for") @db.VarChar(10)
  // What Brick is ready to put in at the hand-over, and where: "Your name, passport number…" and "visa-portal.example". Brick
  // names it before it hands over; the person's one tap fills in exactly this and nothing else.
  readyWhat      String?   @map("ready_what") @db.VarChar(150)
  readyWhere     String?   @map("ready_where") @db.VarChar(150)
  // Who has the mouse and keyboard: brick or person
  control        String    @default("brick") @db.VarChar(10)
  reservationKey String?   @map("reservation_key") @db.VarChar(255)
  // Seconds the machine was held for this job, and when the current stretch began, so cost is worked out from what ran
  secondsRun     Int       @default(0) @map("seconds_run")
  stretchStarted DateTime? @map("stretch_started")
  createdAt      DateTime  @default(now()) @map("created_at")
  startedAt      DateTime? @map("started_at")
  endedAt        DateTime? @map("ended_at")
  // When the sweep last tried a job that waits in line, so Bricks that stay blocked go behind the ones not tried yet
  lastTriedAt    DateTime? @map("last_tried_at")

  bot     Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  effects ComputerEffect[]

  @@index([botId, status])
  @@index([personId, status])
  @@map("computer_jobs")
}

// An effect outside the computer that a job meant to have, written BEFORE it is tried and once per key, so a retry looks up
// what happened and never does it twice: a lost "created" answer is never a second pull request, send or purchase.
model ComputerEffect {
  id        String    @id @default(uuid())
  jobId     String    @map("job_id")
  effectKey String    @map("effect_key") @db.VarChar(255)
  // send, publish, details, upload, pay, submit
  kind      String    @db.VarChar(10)
  // approved (the person asked for it, not tried yet), planned (tried or about to be: the outcome may be unknown), done
  // (confirmed), failed (confirmed not done)
  state     String    @default("planned") @db.VarChar(10)
  // Where it went and what proves it (an address, a number): never what was in it
  evidence  String?   @db.VarChar(500)
  createdAt DateTime  @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")

  job ComputerJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, effectKey])
  @@map("computer_effects")
}
